/* GDD 12.2: cream cards, big rounded corners, gold primary, light grey secondary.
   Sizes are in reference pixels (1080 x 1920, width-matched). */

.hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: rgb(74, 59, 42);
}

.world-layer, .popup-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.hidden { display: none; }

/* ---------- Top bar ---------- */
.top-bar {
    position: absolute;
    top: 28px; left: 28px; right: 28px;
    flex-direction: row;
    align-items: center;
}

.round-button {
    width: 112px; height: 112px;
    margin: 0;
    border-width: 0;
    border-radius: 56px;
    background-color: rgb(255, 248, 236);
    color: rgb(74, 59, 42);
    font-size: 54px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.round-button:active { scale: 0.92 0.92; }

.title-card {
    flex-grow: 1;
    margin: 0 22px;
    padding: 16px 36px 22px 36px;
    border-radius: 50px;
    background-color: rgb(255, 248, 236);
}

.title-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.title, .percent {
    font-size: 46px;
    -unity-font-style: bold;
    margin: 0; padding: 0;
}

.progress-track {
    height: 22px;
    margin-top: 10px;
    border-radius: 11px;
    background-color: rgb(230, 222, 208);
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    width: 0;
    border-radius: 11px;
    background-color: rgb(245, 196, 67);
    transition-property: width;
    transition-duration: 0.25s;
}

/* ---------- Coins ---------- */
.coin-row {
    position: absolute;
    top: 168px; left: 28px; right: 28px;
    flex-direction: row;
    justify-content: flex-end;
}

.coin-pill {
    flex-direction: row;
    align-items: center;
    padding: 8px 28px 8px 12px;
    border-radius: 40px;
    background-color: rgb(255, 248, 236);
    transition-property: scale;
    transition-duration: 0.12s;
}

.coin-pill.pulse { scale: 1.15 1.15; }

.coin-icon {
    width: 46px; height: 46px;
    border-radius: 23px;
    border-width: 5px;
    border-color: rgb(214, 158, 30);
    background-color: rgb(255, 210, 80);
}

.coin-text {
    margin-left: 12px;
    font-size: 40px;
    -unity-font-style: bold;
}

/* ---------- 3D-anchored labels and popups ---------- */
.shelf-label {
    position: absolute;
    translate: -50% -50%;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(74, 59, 42);
}

.coin-popup {
    position: absolute;
    translate: -50% -50%;
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(255, 205, 70);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(110, 70, 10);
}

/* ---------- Toast ---------- */
.toast {
    position: absolute;
    bottom: 290px; left: 12%; right: 12%;
    padding: 18px 28px;
    border-radius: 36px;
    background-color: rgba(40, 32, 24, 0.85);
    color: rgb(255, 248, 236);
    font-size: 36px;
    -unity-text-align: middle-center;
    white-space: normal;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.toast--visible { opacity: 1; }

/* ---------- Tool bar ---------- */
.toolbar {
    position: absolute;
    bottom: 28px; left: 28px; right: 28px;
    flex-direction: row;
    padding: 14px;
    border-radius: 50px;
    background-color: rgb(255, 248, 236);
}

.tool {
    flex-grow: 1;
    flex-basis: 0;
    height: 172px;
    margin: 0 7px;
    border-width: 0;
    border-radius: 38px;
    background-color: rgb(239, 233, 223);
    align-items: center;
    justify-content: center;
}

.tool:active { scale: 0.95 0.95; }
.tool--selected { background-color: rgb(255, 214, 102); }
.tool--locked { opacity: 0.5; }

.tool-glyph {
    font-size: 66px;
    -unity-font-style: bold;
    margin: 0; padding: 0;
}

.tool-name {
    font-size: 30px;
    -unity-font-style: bold;
    margin: 0; padding: 0;
}

/* ---------- Modal cards ---------- */
.banner, .settings {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 14, 8, 0.45);
}

.banner-card {
    width: 80%;
    padding: 48px;
    border-radius: 56px;
    background-color: rgb(255, 248, 236);
    align-items: center;
}

.banner-title {
    font-size: 58px;
    -unity-font-style: bold;
}

.banner-percent {
    font-size: 120px;
    -unity-font-style: bold;
    color: rgb(230, 170, 30);
}

.primary-button, .secondary-button {
    width: 100%;
    height: 120px;
    margin: 24px 0 0 0;
    border-width: 0;
    border-radius: 40px;
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(74, 59, 42);
}

.primary-button { background-color: rgb(245, 196, 67); }
.secondary-button { background-color: rgb(233, 228, 220); }

/* ---------- Collection Book button (second row, left of coins) ---------- */
.coin-row { align-items: center; }

.book-button {
    height: 84px;
    margin: 0 16px 0 0;
    padding: 0 30px;
    border-width: 0;
    border-radius: 42px;
    background-color: rgb(255, 248, 236);
    flex-direction: row;
    align-items: center;
    transition-property: scale;
    transition-duration: 0.12s;
}

.book-button.pulse { scale: 1.2 1.2; }

.book-button-text {
    font-size: 36px;
    -unity-font-style: bold;
    margin: 0; padding: 0;
}

.book-badge {
    position: absolute;
    top: -10px; right: -10px;
    width: 44px; height: 44px;
    border-radius: 22px;
    background-color: rgb(232, 76, 61);
    color: rgb(255, 255, 255);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0; margin: 0;
}

/* ---------- Rare find card (GDD 9.3, concept 03 minus the sell button) ---------- */
.rare-card-layer {
    position: absolute;
    left: 0; right: 0; bottom: 120px;
    align-items: center;
}

.rare-card {
    width: 82%;
    padding: 70px 48px 44px 48px;
    border-radius: 56px;
    background-color: rgb(255, 248, 236);
    align-items: center;
}

.rare-tab {
    position: absolute;
    top: -46px;
    padding: 14px 64px;
    border-radius: 46px;
    background-color: rgb(245, 196, 67);
}

.rare-tab-text {
    font-size: 52px;
    -unity-font-style: bold;
    margin: 0; padding: 0;
}

.rare-name {
    font-size: 56px;
    -unity-font-style: bold;
}

.rare-description {
    margin-top: 12px;
    font-size: 36px;
    color: rgb(130, 112, 92);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- Collection Book page ---------- */
.book-card { width: 88%; }

.book-count {
    font-size: 40px;
    color: rgb(130, 112, 92);
    margin-bottom: 20px;
}

.book-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.book-entry {
    width: 260px;
    margin: 14px;
    padding: 20px 10px;
    border-radius: 36px;
    background-color: rgb(246, 238, 224);
    align-items: center;
}

.book-entry--mascot { background-color: rgb(255, 236, 180); }

.book-icon {
    width: 140px; height: 140px;
    border-radius: 70px;
    border-width: 6px;
    border-color: rgb(230, 170, 30);
    align-items: center;
    justify-content: center;
}

.book-icon--missing {
    background-color: rgb(214, 206, 192);
    border-color: rgb(190, 180, 164);
}

.book-icon-text {
    font-size: 70px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.book-entry-name {
    margin-top: 12px;
    font-size: 30px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- Collection viewer (GDD 9.1.1) ---------- */
.book-entry--found:hover { scale: 1.04 1.04; }
.book-entry--found:active { scale: 0.96 0.96; }

.viewer-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: space-between;
    padding: 120px 70px 90px 70px;
}

.viewer-top, .viewer-bottom { align-items: center; }

.viewer-name {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(255, 236, 190);
}

.viewer-hint {
    margin-top: 8px;
    font-size: 28px;
    color: rgba(255, 248, 236, 0.6);
    white-space: normal;
    -unity-text-align: middle-center;
}

.viewer-description {
    font-size: 36px;
    color: rgb(255, 248, 236);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

/* ---------- Shelf labels; the Auto Sort shelf is tagged (GDD 10.2) ---------- */
.shelf-label { align-items: center; }

.shelf-label-text {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(74, 59, 42);
    margin: 0; padding: 0;
}

.shelf-label--auto .shelf-label-text { color: rgb(196, 128, 0); }

/* ---------- Auto Sort boost: tool bar button, shelf picker, store ---------- */
.tool--boost { background-color: rgb(214, 232, 255); }

.boost-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 8px 0;
    padding: 18px 26px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 34px;
    background-color: rgb(246, 238, 224);
}

.boost-row--selected {
    border-color: rgb(245, 196, 67);
    background-color: rgb(255, 240, 200);
}

.store-buy {
    height: 96px;
    margin: 0 0 0 16px;
    padding: 0 30px;
    border-width: 0;
    border-radius: 34px;
    background-color: rgb(84, 176, 92);
    color: rgb(255, 255, 255);
    font-size: 36px;
    -unity-font-style: bold;
}

.shop-requirement {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(190, 90, 60);
    white-space: normal;
    margin: 4px 0 0 0; padding: 0;
}

.book-entry-venue {
    font-size: 24px;
    color: rgb(130, 112, 92);
    margin: 2px 0 0 0; padding: 0;
}

.big-toast {
    position: absolute;
    top: 19%; left: 8%; right: 8%;
    padding: 30px 36px;
    border-radius: 48px;
    background-color: rgb(245, 196, 67);
    color: rgb(74, 59, 42);
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    opacity: 0;
    scale: 0.8 0.8;
    transition-property: opacity, scale;
    transition-duration: 0.25s;
}

.big-toast--visible { opacity: 1; scale: 1 1; }

/* ---------- M3: shop ---------- */
.shop-list { width: 100%; }

.shop-header {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(130, 112, 92);
    margin: 14px 0 0 12px; padding: 0;
}

.shop-row {
    flex-direction: row;
    align-items: center;
    margin: 10px 0;
    padding: 18px 22px;
    border-radius: 34px;
    background-color: rgb(246, 238, 224);
}

.shop-info { flex-grow: 1; flex-shrink: 1; }

.shop-name {
    font-size: 38px;
    -unity-font-style: bold;
    margin: 0; padding: 0;
}

.shop-effect {
    font-size: 28px;
    color: rgb(130, 112, 92);
    white-space: normal;
    margin: 4px 0 0 0; padding: 0;
}

.shop-buy {
    flex-direction: row;
    align-items: center;
    height: 96px;
    margin: 0 0 0 16px;
    padding: 0 26px 0 16px;
    border-width: 0;
    border-radius: 34px;
    background-color: rgb(245, 196, 67);
}

.shop-buy--poor { opacity: 0.5; }

.shop-cost {
    margin-left: 10px;
    font-size: 36px;
    -unity-font-style: bold;
}

.shop-max {
    margin-left: 16px;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(130, 112, 92);
}

.tool-price {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(196, 128, 0);
    margin: 0; padding: 0;
}

/* ---------- M4: overview, map, transitions ---------- */
.room-label {
    position: absolute;
    translate: -50% -50%;
    align-items: center;
    padding: 10px 26px 14px 26px;
    border-radius: 36px;
    background-color: rgb(255, 248, 236);
}

.room-label-name {
    font-size: 34px;
    -unity-font-style: bold;
    margin: 0; padding: 0;
}

.room-label-badge {
    margin-top: 6px;
    padding: 2px 22px;
    border-radius: 22px;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.room-badge--done { background-color: rgb(84, 176, 92); }
.room-badge--mid { background-color: rgb(236, 176, 46); }
.room-badge--low { background-color: rgb(222, 92, 78); }
.room-badge--locked { background-color: rgb(70, 76, 96); }

.sell-button {
    position: absolute;
    bottom: 60px; left: 12%; right: 12%;
    height: 130px;
    border-width: 0;
    border-radius: 48px;
    background-color: rgb(245, 196, 67);
    color: rgb(74, 59, 42);
    font-size: 46px;
    -unity-font-style: bold;
}

.map-row--current { border-width: 4px; border-color: rgb(245, 196, 67); }

.map-open {
    height: 96px;
    margin: 0 0 0 16px;
    padding: 0 34px;
    border-width: 0;
    border-radius: 34px;
    background-color: rgb(245, 196, 67);
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(74, 59, 42);
}

.sold-tag {
    margin-left: 16px;
    padding: 8px 22px;
    border-radius: 24px;
    background-color: rgb(84, 176, 92);
    color: rgb(255, 255, 255);
    font-size: 30px;
    -unity-font-style: bold;
}

.book-page-title {
    font-size: 42px;
    -unity-font-style: bold;
    margin: 0; padding: 0;
}

.fade {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

/* ---------- Shelf close-up ---------- */
.inspect-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: space-between;
    align-items: center;
    padding: 110px 70px 90px 70px;
}

.inspect-top {
    align-items: center;
    padding: 18px 40px 22px 40px;
    border-radius: 48px;
    background-color: rgba(40, 32, 24, 0.78);
}

.inspect-name {
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(255, 236, 190);
}

.inspect-hint {
    margin-top: 4px;
    font-size: 28px;
    color: rgba(255, 248, 236, 0.75);
    white-space: normal;
    -unity-text-align: middle-center;
}

.inspect-back { width: 60%; }
